# Supabase Configuration
# Replace these with your actual Project URL and Anon/Public Key from Supabase Dashboard -> Project Settings -> API

# For Next.js (App Router / Pages Router):
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Service Role Key (Backend / Server-side only, NEVER expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# For Vite / React (if using Vite instead of Next.js):
# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-public-key
